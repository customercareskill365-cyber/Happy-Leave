# PostgreSQL connection string
# Automatically provided by Netlify Database as NETLIFY_DB_URL in production
DATABASE_URL=postgres://postgres:postgres@localhost:5432/team_leave

# One-time Master Admin Provisioning (run `npm run db:provision-admin`)
MASTER_ADMIN_ID=ADM-01
MASTER_ADMIN_NAME=Master Admin
MASTER_ADMIN_PASSWORD=

# Optional initial Supervisor seed (if migrating existing team)
INITIAL_SUP1_ID=SUP-01
INITIAL_SUP1_NAME=Supervisor One
INITIAL_SUP1_PIN=
INITIAL_SUP2_ID=SUP-02
INITIAL_SUP2_NAME=Supervisor Two
INITIAL_SUP2_PIN=
SEED_DUMMY_EMPLOYEES=false
