# PostgreSQL connection string (automatically provided by Netlify Database in production)
DATABASE_URL=postgres://postgres:postgres@localhost:5432/team_leave

# Initial Supervisor Accounts (set strong PINs before running `npm run db:seed`)
INITIAL_SUP1_ID=SUP-01
INITIAL_SUP1_NAME=Supervisor One
INITIAL_SUP1_PIN=
INITIAL_SUP2_ID=SUP-02
INITIAL_SUP2_NAME=Supervisor Two
INITIAL_SUP2_PIN=

# Set to true only for staging/testing with dummy employees
SEED_DUMMY_EMPLOYEES=false
DUMMY_EMP_PIN=1234
